# ====================================================================
# Environment Variables & Secrets
# ====================================================================
# Ignore actual secret files, but allow tracking example/template configurations
.env
.env.*
!.env.example
!.env.template

# ====================================================================
# Python Virtual Environments
# ====================================================================
# Specifically ignores your .venv folder and other common env names
.venv/
venv/
ENV/
env/

# ====================================================================
# Python Binary & Compiled Artifacts
# ====================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.manifest
*.spec

# ====================================================================
# Distribution / Packaging Build Outputs
# ====================================================================
# Folder outputs from building packages (e.g., pip wheel, setuptools)
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ====================================================================
# Testing, Coverage, and Code Quality Tools
# ====================================================================
.htmlcov/
.tox/
.nosenv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
coverage.xml
*.cover
*.py,cover

# ====================================================================
# Operating System & IDE Specific Files
# ====================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# IDEs (VS Code & PyCharm)
.vscode/
.idea/